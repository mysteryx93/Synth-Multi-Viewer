<SyntaxDefinition name="AviSynth" extensions=".avs;.avsi" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="Comment" foreground="LightGreen" />
	<Color name="String" foreground="Salmon" />
	<Color name="Keyword" foreground="DodgerBlue" fontWeight="bold" />
	<Color name="Builtin" foreground="DeepSkyBlue" fontWeight="bold" />
	<Color name="Digits" foreground="LightSkyBlue" />
	<RuleSet ignoreCase="true">
		<Span color="Comment">
			<Begin>\#</Begin>
		</Span>
		<Span color="Comment" multiline="true">
			<Begin>/\*</Begin>
			<End>\*/</End>
		</Span>
		<Span color="String">
			<Begin>"</Begin>
			<End>"</End>
		</Span>
		<Span color="String">
			<Begin>'</Begin>
			<End>'</End>
		</Span>
		<Keywords color="Keyword">
			<Word>function</Word>
			<Word>global</Word>
			<Word>return</Word>
			<Word>try</Word>
			<Word>catch</Word>
			<Word>if</Word>
			<Word>else</Word>
			<Word>while</Word>
			<Word>for</Word>
			<Word>true</Word>
			<Word>false</Word>
			<Word>last</Word>
		</Keywords>
		<Keywords color="Builtin">
			<Word>BlankClip</Word>
			<Word>Blackness</Word>
			<Word>ColorBars</Word>
			<Word>ConvertToRGB</Word>
			<Word>ConvertToRGB24</Word>
			<Word>ConvertToRGB32</Word>
			<Word>ConvertToYV12</Word>
			<Word>ConvertToYUV420</Word>
			<Word>Crop</Word>
			<Word>Trim</Word>
			<Word>AssumeFPS</Word>
			<Word>Info</Word>
			<Word>Import</Word>
			<Word>Eval</Word>
			<Word>ScriptClip</Word>
		</Keywords>
		<Rule color="Digits">\b\d+(\.\d+)?\b</Rule>
	</RuleSet>
</SyntaxDefinition>
