<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="using:HanumanInstitute.SynthMultiViewer.Helpers"
        xmlns:vm="using:HanumanInstitute.SynthMultiViewer.ViewModels"
        x:Class="HanumanInstitute.SynthMultiViewer.Views.SettingsView"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Classes="dialog-content">
        <StackPanel DockPanel.Dock="Bottom" Classes="dialog-actions">
            <Button Content="Default" Command="{Binding RestoreDefault}" />
            <Button Content="Apply" Command="{Binding Apply}" />
            <Button Content="OK" IsDefault="True" Command="{Binding Ok}" />
            <Button Content="Cancel" IsCancel="True" Command="{Binding Cancel}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Theme" VerticalAlignment="Center" Width="72" />
                <ComboBox Width="140" ItemsSource="{Binding ThemeList}" SelectedItem="{Binding Theme}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Check for Updates" VerticalAlignment="Center" />
                <ComboBox Margin="12,0,0,0" Width="120" ItemsSource="{Binding CheckForUpdateList}"
                          SelectedItem="{Binding CheckForUpdates}" />
            </StackPanel>
            <CheckBox Content="Enhance editor with auto-complete"
                      IsChecked="{Binding EnhanceEditorWithAutoComplete}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="VapourSynth" />
                <TextBlock x:Name="VapourSynthStatus" Text="{Binding VapourSynthStatus}"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                           ToolTip.Tip="{Binding VapourSynthStatusTip}" />
            </StackPanel>
            <DockPanel>
                <TextBlock Text="Library: " VerticalAlignment="Center" />
                <TextBox x:Name="VapourSynthDetectedLibrary" Classes="detected-path"
                         IsReadOnly="True" VerticalAlignment="Center"
                         Text="{Binding VapourSynthLibraryDisplay, Mode=OneWay}" />
            </DockPanel>
            <DockPanel>
                <Button x:Name="BrowseVapourSynthLibrary" DockPanel.Dock="Right" Content="..."
                        MinWidth="32" MinHeight="28" Padding="8,4" Margin="4,0,0,0" VerticalAlignment="Center"
                        ToolTip.Tip="Browse for library" Command="{Binding BrowseVapourSynthLibrary}" />
                <TextBox x:Name="VapourSynthLibraryPath" Text="{Binding VapourSynthPath}"
                         PlaceholderText="Override detected library" />
            </DockPanel>
            <DockPanel>
                <TextBlock Text="Plugin folders: " VerticalAlignment="Center" />
                <TextBox x:Name="VapourSynthDetectedPlugins" Classes="detected-path"
                         IsReadOnly="True" VerticalAlignment="Center"
                         Text="{Binding VapourSynthPluginsDisplay, Mode=OneWay}" />
            </DockPanel>
            <DockPanel>
                <Button x:Name="BrowseVapourSynthPlugins" DockPanel.Dock="Right" Content="..."
                        MinWidth="32" MinHeight="28" Padding="8,4" Margin="4,0,0,0" VerticalAlignment="Center"
                        ToolTip.Tip="Browse for plugin folder" Command="{Binding BrowseVapourSynthPlugins}" />
                <TextBox x:Name="VapourSynthPluginFolders" Text="{Binding VapourSynthPluginFolders}"
                         PlaceholderText="Extra folders, separated by ;" />
            </DockPanel>
            <StackPanel Spacing="0">
                <CheckBox Content="Do not load auto-detected plugin folders"
                          IsChecked="{Binding VapourSynthReplacePlugins}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="VapourSynth threads" VerticalAlignment="Center" />
                    <NumericUpDown x:Name="VapourSynthThreads" Width="80" Minimum="1" Maximum="256"
                                   Increment="1" FormatString="0" ParsingNumberStyle="Integer"
                                   ShowButtonSpinner="False" h:NumericKeep.RevertEmpty="True"
                                   Value="{Binding VapourSynthThreads, Converter={x:Static h:KeepNumberConverter.Instance}}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                <TextBlock FontWeight="SemiBold" Text="AviSynth"
                           ToolTip.Tip="AviSynth+, AviSynth 2.6, or a fork that exports the C API" />
                <TextBlock x:Name="AviSynthStatus" Text="{Binding AviSynthStatus}"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                           ToolTip.Tip="{Binding AviSynthStatusTip}" />
            </StackPanel>
            <DockPanel>
                <TextBlock Text="Library: " VerticalAlignment="Center" />
                <TextBox x:Name="AviSynthDetectedLibrary" Classes="detected-path"
                         IsReadOnly="True" VerticalAlignment="Center"
                         Text="{Binding AviSynthLibraryDisplay, Mode=OneWay}" />
            </DockPanel>
            <DockPanel>
                <Button x:Name="BrowseAviSynthLibrary" DockPanel.Dock="Right" Content="..."
                        MinWidth="32" MinHeight="28" Padding="8,4" Margin="4,0,0,0" VerticalAlignment="Center"
                        ToolTip.Tip="Browse for library" Command="{Binding BrowseAviSynthLibrary}" />
                <TextBox x:Name="AviSynthLibraryPath" Text="{Binding AviSynthPath}"
                         PlaceholderText="Override detected library" />
            </DockPanel>
            <DockPanel>
                <TextBlock Text="Plugin folders: " VerticalAlignment="Center" />
                <TextBox x:Name="AviSynthDetectedPlugins" Classes="detected-path"
                         IsReadOnly="True" VerticalAlignment="Center"
                         Text="{Binding AviSynthPluginsDisplay, Mode=OneWay}" />
            </DockPanel>
            <DockPanel>
                <Button x:Name="BrowseAviSynthPlugins" DockPanel.Dock="Right" Content="..."
                        MinWidth="32" MinHeight="28" Padding="8,4" Margin="4,0,0,0" VerticalAlignment="Center"
                        ToolTip.Tip="Browse for plugin folder" Command="{Binding BrowseAviSynthPlugins}" />
                <TextBox x:Name="AviSynthPluginFolders" Text="{Binding AviSynthPluginFolders}"
                         PlaceholderText="Extra folders, separated by ;" />
            </DockPanel>
            <CheckBox Content="Do not load auto-detected plugin folders"
                      IsChecked="{Binding AviSynthReplacePlugins}" />
        </StackPanel>
    </DockPanel>
</Window>
