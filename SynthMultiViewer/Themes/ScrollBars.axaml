<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <x:Double x:Key="AppScrollBarSize">14</x:Double>
            <SolidColorBrush x:Key="AppScrollBarGutter" Color="{DynamicResource SystemChromeLowColor}" />
            <SolidColorBrush x:Key="AppScrollBarTrack" Color="{DynamicResource SystemBaseLowColor}" />
            <SolidColorBrush x:Key="AppScrollBarThumb" Color="{DynamicResource SystemBaseMediumColor}" />
            <SolidColorBrush x:Key="AppScrollBarThumbPointerOver" Color="{DynamicResource SystemBaseMediumHighColor}" />
            <SolidColorBrush x:Key="AppScrollBarThumbPressed" Color="{DynamicResource SystemBaseHighColor}" />

            <ControlTheme x:Key="AppScrollBarPageButton" TargetType="RepeatButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="AppScrollBarThumbVertical" TargetType="Thumb">
                <Setter Property="Background" Value="{DynamicResource AppScrollBarThumb}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Width" Value="{DynamicResource AppScrollBarSize}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent">
                            <Border Name="PART_ThumbFill" Width="6" Margin="0,1"
                                    HorizontalAlignment="Center" CornerRadius="3"
                                    Background="{TemplateBinding Background}" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource AppScrollBarThumbPointerOver}" />
                </Style>
                <Style Selector="^:pressed">
                    <Setter Property="Background" Value="{DynamicResource AppScrollBarThumbPressed}" />
                </Style>
                <Style Selector="^:disabled /template/ Border#PART_ThumbFill">
                    <Setter Property="Opacity" Value="0.4" />
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="AppScrollBarThumbHorizontal" TargetType="Thumb">
                <Setter Property="Background" Value="{DynamicResource AppScrollBarThumb}" />
                <Setter Property="MinWidth" Value="24" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="{DynamicResource AppScrollBarSize}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent">
                            <Border Name="PART_ThumbFill" Height="6" Margin="1,0"
                                    VerticalAlignment="Center" CornerRadius="3"
                                    Background="{TemplateBinding Background}" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource AppScrollBarThumbPointerOver}" />
                </Style>
                <Style Selector="^:pressed">
                    <Setter Property="Background" Value="{DynamicResource AppScrollBarThumbPressed}" />
                </Style>
                <Style Selector="^:disabled /template/ Border#PART_ThumbFill">
                    <Setter Property="Opacity" Value="0.4" />
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
                <Setter Property="MinWidth" Value="{DynamicResource AppScrollBarSize}" />
                <Setter Property="MinHeight" Value="{DynamicResource AppScrollBarSize}" />
                <Setter Property="Background" Value="{DynamicResource AppScrollBarGutter}" />
                <Style Selector="^:vertical">
                    <Setter Property="Width" Value="{DynamicResource AppScrollBarSize}" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Name="PART_Gutter" Background="{TemplateBinding Background}"
                                    Width="{DynamicResource AppScrollBarSize}">
                                <Panel>
                                    <Border Name="PART_Track" Width="6" Margin="0,2"
                                            HorizontalAlignment="Center" CornerRadius="3"
                                            Background="{DynamicResource AppScrollBarTrack}"
                                            IsHitTestVisible="False" />
                                    <Track Minimum="{TemplateBinding Minimum}"
                                           Maximum="{TemplateBinding Maximum}"
                                           Value="{TemplateBinding Value, Mode=TwoWay}"
                                           ViewportSize="{TemplateBinding ViewportSize}"
                                           Orientation="{TemplateBinding Orientation}"
                                           DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                           IsDirectionReversed="True">
                                        <Track.DecreaseButton>
                                            <RepeatButton Name="PART_PageUpButton"
                                                          Theme="{StaticResource AppScrollBarPageButton}"
                                                          Focusable="False"
                                                          AutomationProperties.Name="Page up" />
                                        </Track.DecreaseButton>
                                        <Track.IncreaseButton>
                                            <RepeatButton Name="PART_PageDownButton"
                                                          Theme="{StaticResource AppScrollBarPageButton}"
                                                          Focusable="False"
                                                          AutomationProperties.Name="Page down" />
                                        </Track.IncreaseButton>
                                        <Track.Thumb>
                                            <Thumb Theme="{StaticResource AppScrollBarThumbVertical}"
                                                   AutomationProperties.Name="Position" />
                                        </Track.Thumb>
                                    </Track>
                                </Panel>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="^:horizontal">
                    <Setter Property="Height" Value="{DynamicResource AppScrollBarSize}" />
                    <Setter Property="VerticalAlignment" Value="Bottom" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Name="PART_Gutter" Background="{TemplateBinding Background}"
                                    Height="{DynamicResource AppScrollBarSize}">
                                <Panel>
                                    <Border Name="PART_Track" Height="6" Margin="2,0"
                                            VerticalAlignment="Center" CornerRadius="3"
                                            Background="{DynamicResource AppScrollBarTrack}"
                                            IsHitTestVisible="False" />
                                    <Track Minimum="{TemplateBinding Minimum}"
                                           Maximum="{TemplateBinding Maximum}"
                                           Value="{TemplateBinding Value, Mode=TwoWay}"
                                           ViewportSize="{TemplateBinding ViewportSize}"
                                           Orientation="{TemplateBinding Orientation}"
                                           DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
                                        <Track.DecreaseButton>
                                            <RepeatButton Name="PART_PageUpButton"
                                                          Theme="{StaticResource AppScrollBarPageButton}"
                                                          Focusable="False"
                                                          AutomationProperties.Name="Page left" />
                                        </Track.DecreaseButton>
                                        <Track.IncreaseButton>
                                            <RepeatButton Name="PART_PageDownButton"
                                                          Theme="{StaticResource AppScrollBarPageButton}"
                                                          Focusable="False"
                                                          AutomationProperties.Name="Page right" />
                                        </Track.IncreaseButton>
                                        <Track.Thumb>
                                            <Thumb Theme="{StaticResource AppScrollBarThumbHorizontal}"
                                                   AutomationProperties.Name="Position" />
                                        </Track.Thumb>
                                    </Track>
                                </Panel>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
